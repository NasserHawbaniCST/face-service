# Copy to .env (docker compose) or /etc/face-service.env (systemd) and fill in.
# chmod 600 the file - it holds the credentials the gateway signs requests with.
# Generate values with:  python -m app.genkeys   (or: openssl rand -hex 32)

# ---- credentials (REQUIRED; >= 32 characters each) ----------------------------
FACE_API_KEY_1=
FACE_HMAC_SECRET_1=
# Second slot, only while rotating keys (see README "Key rotation"):
# FACE_API_KEY_2=
# FACE_HMAC_SECRET_2=
# (FACE_HMAC_SECRET applies to a slot that has no own secret)

# ---- network -------------------------------------------------------------------
# Only these client addresses / CIDRs may call /v1/analyze (comma separated).
# STRONGLY recommended: the gateway's public IP.   /health stays open.
FACE_ALLOWED_IPS=
# Reverse proxies whose X-Forwarded-For is believed (Caddy / nginx in front).
# Docker compose + Caddy: 172.16.0.0/12 ; same-host nginx: 127.0.0.1
FACE_TRUSTED_PROXIES=

# ---- capacity -----------------------------------------------------------------
# Engines = threads that analyse in parallel (each ~40 MB of models + working memory).
# Default: min(CPU cores, 4).
FACE_WORKERS=2
# OpenCV intra-op threads per engine (1 is right when FACE_WORKERS ~ cores)
FACE_CV_THREADS=1
# Requests allowed to WAIT for a free engine before answering 503 BUSY (default 2 x workers)
FACE_MAX_QUEUE=4
FACE_REQUEST_TIMEOUT=20

# ---- limits -------------------------------------------------------------------
FACE_RATE_LIMIT_PER_MIN=120
FACE_AUTH_FAIL_LIMIT_PER_MIN=30
FACE_MAX_BODY_BYTES=4194304
FACE_MAX_FRAMES=6
FACE_MAX_FRAME_BYTES=409600
FACE_TS_TOLERANCE=60

# ---- misc ---------------------------------------------------------------------
# FACE_MODELS_DIR=/srv/face_service/models
FACE_LOG_LEVEL=INFO

# ---- docker compose only ---------------------------------------------------------
# Address the published port binds to. Keep 127.0.0.1 when Caddy / nginx terminates TLS
# on the same host; use the server's private IP if the gateway reaches it over a private network.
FACE_BIND=127.0.0.1
# Caddy profile: the DNS name that points to this server (certificate is automatic)
FACE_DOMAIN=face.example.com
